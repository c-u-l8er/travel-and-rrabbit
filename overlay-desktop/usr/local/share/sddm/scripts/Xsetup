#!/bin/sh
# Xsetup - run as root, on the greeter's X server, BEFORE the login dialog.
#
# TELL THE GREETER HOW BIG THE SCREEN IS, because Qt cannot find out.
#
# Measured on this image, printed on the greeter itself and read off a
# screenshot: `Screen.width` is **0**, `Screen.height` is **0**, and SDDM's own
# `screenModel.geometry(primary)` is `{"width":0,"height":0}`. Qt6's xcb plugin
# gets screen geometry from RandR, and `scfb` -- the dumb-framebuffer driver
# this image uses, because there is no DRM module to mode-set with -- publishes
# no RandR outputs at all. So every Qt-side answer is zero.
#
# SDDM sizes the greeter WINDOW to the theme's root item (verified: a root item
# hard-coded to 3840x2160 filled a 3840x2160 screen). That makes the root item's
# size the one number that matters, and it has to come from outside Qt.
#
# `xrdb -symbols` is the query. It answers over the X core protocol, which
# always knows the screen dimensions, and it ships with X itself -- this image
# has no xrandr, no xdpyinfo and no xwininfo to ask instead.
#
# Order matters and it is on our side: sddm.log shows this script running, then
# "Display server started", then "Loading theme configuration from
# .../theme.conf". So a value written here is read by the greeter that follows.
#
# theme.conf.user IS NOT SUPPORTED by this SDDM (`strings` on the binaries finds
# no such string), so the generated keys go into theme.conf itself. That means
# **theme.conf on a running machine is generated and will always differ from the
# overlay's copy** -- expected, and not something to push back.
set -u

THEME=/usr/local/share/sddm/themes/tandr
CONF=$THEME/theme.conf

command -v xrdb >/dev/null 2>&1 || exit 0
[ -d "$THEME" ] || exit 0

W=$(xrdb -symbols 2>/dev/null | sed -n 's/^-DWIDTH=//p')
H=$(xrdb -symbols 2>/dev/null | sed -n 's/^-DHEIGHT=//p')

# A greeter that cannot be logged into is the worst outcome this image has, so
# anything unexpected leaves the file exactly as it was and the theme falls back
# to its own default size.
case "$W" in ''|*[!0-9]*) exit 0 ;; esac
case "$H" in ''|*[!0-9]*) exit 0 ;; esac
[ "$W" -gt 0 ] && [ "$H" -gt 0 ] || exit 0

# Written through a temporary file and moved into place, so a greeter starting
# while this runs can never read half a config.
TMP=$CONF.new
{
    echo "[General]"
    echo "background=/usr/local/share/tandr/wallpaper.jpg"
    echo "# Generated by Xsetup on every boot -- see the note above."
    echo "screenWidth=$W"
    echo "screenHeight=$H"
} > "$TMP" && mv "$TMP" "$CONF"
